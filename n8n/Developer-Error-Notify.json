erflow-wrap: anywhere; background: #f3f4f6; padding: 14px; border-radius: 6px; font-size: 12px; line-height: 1.5;\">{{ $json.body.traceback }}</pre>\n\n    <div style=\"margin-top: 22px; padding: 15px; background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 6px;\">\n      <strong>Required Action</strong>\n      <p style=\"margin-bottom: 0; font-size: 14px;\">\n        Investigate the failed stage, resolve the reported issue, and verify the source data before rerunning the pipeline.\n      </p>\n    </div>\n  </div>\n\n  <div style=\"background: #f9fafb; border-top: 1px solid #e5e7eb; padding: 15px; text-align: center; color: #6b7280; font-size: 12px;\">\n    Automated notification · E-commerce Performance Monitor\n  </div>\n\n</div>\n",
